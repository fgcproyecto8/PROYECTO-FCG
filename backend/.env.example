# Variables de entorno opcionales para backend/config/settings.py.
#
# El proyecto NO usa python-dotenv (no se agregaron dependencias nuevas),
# asi que este archivo es solo documentacion: si querés usar estos
# valores tenés que exportarlos vos como variables de entorno reales
# antes de levantar Django (por ejemplo, en la configuracion de tu
# servidor/hosting, o con `export VAR=valor` en tu shell).
#
# Si ninguna de estas variables esta definida, el comportamiento es
# exactamente el mismo que antes (misma SECRET_KEY de desarrollo,
# DEBUG=True, ALLOWED_HOSTS vacio, SQLite en backend/db.sqlite3).
#
# En produccion las define docker-compose.yml (raiz del repo); ahi no
# hace falta tocar nada salvo las marcadas como "opcional en el servidor".

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-real-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Origenes https:// aceptados por CSRF (login del panel /admin/).
DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.com

# True solo si hay un proxy HTTPS delante que envie X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=True

# Carpeta para db.sqlite3 (y la clave secreta generada si no se define
# DJANGO_SECRET_KEY). Sin definir: la carpeta backend/.
DJANGO_DATA_DIR=/code/data

# Opcional en el servidor: si se definen, al arrancar se crea este
# superusuario para entrar a /admin/ (si ya existe, no se toca).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@tudominio.com
DJANGO_SUPERUSER_PASSWORD=cambiar-por-una-contrasena-segura
