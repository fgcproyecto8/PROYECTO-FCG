# Variables de entorno opcionales para backend/config/settings.py.
#
# El proyecto NO usa python-dotenv (no se agregaron dependencias nuevas),
# asi que este archivo es solo documentacion: si querés usar estos
# valores tenés que exportarlos vos como variables de entorno reales
# antes de levantar Django (por ejemplo, en la configuracion de tu
# servidor/hosting, o con `export VAR=valor` en tu shell).
#
# Si ninguna de estas variables esta definida, el comportamiento es
# exactamente el mismo que antes (misma SECRET_KEY de desarrollo,
# DEBUG=True, ALLOWED_HOSTS vacio, base de datos SQLite local).

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-real-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Base de datos PostgreSQL de producción. Si DJANGO_DEBUG=False y esta
# variable no esta definida, Django va a rechazar arrancar (a
# proposito: ver config/settings.py) en vez de usar SQLite en
# produccion sin que nadie lo note. En desarrollo local, con
# DJANGO_DEBUG sin definir (o en True), esta variable no hace falta:
# se sigue usando SQLite.
DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_de_la_base
