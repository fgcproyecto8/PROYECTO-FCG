# Variables para docker-compose.yml. Copiar este archivo a ".env" en
# la misma carpeta y completar con valores reales; ".env" está en
# .gitignore, nunca se versiona.
#
# No hay valores reales ni secretos acá, solo ejemplos.

# --- PostgreSQL (servicio "db") ---
POSTGRES_DB=partidoya
POSTGRES_USER=partidoya
POSTGRES_PASSWORD=cambiar-por-una-contraseña-real

# --- Backend (servicio "backend") ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-real
# Dominio público de la API, sin esquema ni barra final.
DJANGO_ALLOWED_HOSTS=api.app6.academia.ar
# Orígenes completos (con https://) desde los que se puede enviar un
# formulario/CSRF token válido contra el admin de Django. Normalmente
# los mismos dominios públicos del frontend y del backend.
DJANGO_CSRF_TRUSTED_ORIGINS=https://app6.academia.ar,https://api.app6.academia.ar

# --- Puertos publicados en el host (ajustar según lo que permita el
#     servidor de la universidad; no lo sabemos desde el repositorio) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
