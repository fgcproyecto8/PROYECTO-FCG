# Variable de entorno opcional para frontend/src/services/api.js.
#
# Si no se define, el frontend usa http://127.0.0.1:8000/api (backend
# local). Vite carga .env.production automaticamente al correr
# `npm run build` (ver frontend/.env.production), y .env/.env.local
# al correr `npm run dev` si existieran.

VITE_API_URL=https://api.app6.academia.ar/api
